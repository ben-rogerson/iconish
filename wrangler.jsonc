{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iconish",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "out",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "iconish.benrogerson.dev",
      "custom_domain": true
    }
  ]
}
